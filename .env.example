# ---------------------------------------------------------------------
# Q Signals - Environment Configuration
#
# Copy this file to .env and fill in the values you need.
# ---------------------------------------------------------------------

# Application
DEBUG=True

# Server
HOST=127.0.0.1
PORT=8000

# Binance
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Finnhub (https://finnhub.io) - required for forex/stocks
FINNHUB_API_KEY=

# Logging
LOG_LEVEL=INFO

# Redis (future use)
REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
